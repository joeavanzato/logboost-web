# .env.example - LogBoost Web Container Environment Variables
# Copy to .env and customize for your deployment
# SECRET_KEY is required; everything else has a sensible default

# ============================================================
# SECURITY - Override these for production deployments
# ============================================================

# Flask session signing key
# REQUIRED FOR PRODUCTION: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: The default (dev-placeholder-change-me-in-production) is publicly known.
#          All sessions are signed with this key — override it in production.
SECRET_KEY=change-me-generate-with-secrets-token-hex-32

# Number of reverse proxies in front of the app (0 = none, the default).
# Set this when running behind nginx/Traefik/etc. so audit entries and login
# throttling see the real client address instead of the proxy's.
# TRUSTED_PROXY_COUNT=0

# Flask environment mode
# "production" enables secure (HTTPS-only) session cookies
# "development" allows HTTP session cookies (local dev only)
FLASK_ENV=production

# ============================================================
# LOGBOOST BINARY
# ============================================================

# Path to the LogBoost Linux binary inside the container
# Mount the host binary into the container at this path
# Example: docker run -v /usr/local/bin/logboost:/usr/local/bin/logboost:ro ...
LOGBOOST_PATH=/usr/local/bin/logboost

# ============================================================
# DATA PATHS - Mount matching directories from host
# ============================================================

# Directory containing MaxMind GeoIP databases (*.mmdb files)
# Must contain: GeoLite2-City.mmdb, GeoLite2-ASN.mmdb, GeoLite2-Country.mmdb
# Example: docker run -v /opt/logboost/maxmind:/data/maxmind:ro ...
MAXMIND_DIR=/data/maxmind

# Directory containing threat intelligence database (threats.db)
# Must be writable: LogBoost rebuilds threats.db here and the app adds indexes to it.
# Example: docker run -v /opt/logboost/intel:/data/intel ...
THREAT_DB_DIR=/data/intel

# Path to the admin SQLite database file
# Default: /app/logboost_admin.db (inside container working directory)
# Override to use a volume-mounted database for persistence across rebuilds
# Example: docker run -v /opt/logboost/data/admin.db:/data/logboost_admin.db ...
LOGBOOST_DB_PATH=/app/logboost_admin.db

# ============================================================
# LOGGING
# ============================================================

# Gunicorn log level (debug, info, warning, error, critical)
# Controls both access log and error log verbosity
# Default: info
LOGBOOST_LOG_LEVEL=info

# ============================================================
# VOLUME MOUNT PATHS (Phase 2)
# These are set in docker-compose.yml environment section.
# Override here ONLY if your mount paths differ from defaults.
# ============================================================

# Admin SQLite database path inside container
# IMPORTANT: docker-compose.yml overrides this to /data/db/logboost_admin.db
# for persistence. The Dockerfile default (/app/logboost_admin.db) is baked into
# the image and lost on rebuild. Do NOT change unless you also update compose volumes.
# LOGBOOST_DB_PATH=/data/db/logboost_admin.db

# ============================================================
# HOST SETUP (run once before first docker compose up)
# ============================================================
# sudo mkdir -p /opt/logboost/{maxmind,intel,cache,config,db,uploads,output}
# sudo chown -R 1000:1000 /opt/logboost

# ============================================================
# BACKUPS
# ============================================================

# The scheduled backup copies the admin database. threats.db can be rebuilt from the
# feeds and is large, so it is left out unless this is set to 1.
# BACKUP_INCLUDE_THREATS=0

# Days to keep backup files (0 keeps them forever)
# BACKUP_KEEP_DAYS=7

# ============================================================
# SSL CONFIGURATION
# ============================================================

# HTTPS port for secure access
# Default: 8443
# SSL_PORT=8443

# Common Name (CN) for auto-generated self-signed certificate
# Set to your server's hostname or IP address for valid certificate
# Default: localhost
# SSL_COMMON_NAME=localhost

# Custom SSL Certificates:
# To use your own certificates instead of auto-generated ones,
# mount them to the logboost-ssl volume:
#   docker run -v /path/to/your/cert.pem:/data/ssl/cert.pem:ro \
#              -v /path/to/your/key.pem:/data/ssl/key.pem:ro ...
#
# Or with bind mounts in docker-compose.yml:
#   volumes:
#     - /etc/ssl/certs/logboost.crt:/data/ssl/cert.pem:ro
#     - /etc/ssl/private/logboost.key:/data/ssl/key.pem:ro
#
# Certificate requirements:
# - cert.pem: PEM-encoded X.509 certificate
# - key.pem: PEM-encoded private key (must match certificate)
# - Entrypoint validates cert/key modulus match on startup
