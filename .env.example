# .env.example - LogBoost Web Container Environment Variables
# Copy to .env and customize for your deployment
# All variables have sensible defaults - none are required

# ============================================================
# SECURITY - Override these for production deployments
# ============================================================

# Flask session signing key
# REQUIRED FOR PRODUCTION: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: The default (dev-placeholder-change-me-in-production) is publicly known.
#          All sessions are signed with this key — override it in production.
SECRET_KEY=change-me-generate-with-secrets-token-hex-32

# Flask environment mode
# "production" enables secure (HTTPS-only) session cookies
# "development" allows HTTP session cookies (local dev only)
FLASK_ENV=production

# ============================================================
# LOGBOOST BINARY
# ============================================================

# Path to the LogBoost Linux binary inside the container
# Mount the host binary into the container at this path
# Example: docker run -v /usr/local/bin/logboost:/usr/local/bin/logboost:ro ...
LOGBOOST_PATH=/usr/local/bin/logboost

# ============================================================
# DATA PATHS - Mount matching directories from host
# ============================================================

# Directory containing MaxMind GeoIP databases (*.mmdb files)
# Must contain: GeoLite2-City.mmdb, GeoLite2-ASN.mmdb, GeoLite2-Country.mmdb
# Example: docker run -v /opt/logboost/maxmind:/data/maxmind:ro ...
MAXMIND_DIR=/data/maxmind

# Directory containing threat intelligence database (threats.db)
# Example: docker run -v /opt/logboost/intel:/data/intel:ro ...
THREAT_DB_DIR=/data/intel

# Path to the admin SQLite database file
# Default: /app/logboost_admin.db (inside container working directory)
# Override to use a volume-mounted database for persistence across rebuilds
# Example: docker run -v /opt/logboost/data/admin.db:/data/logboost_admin.db ...
LOGBOOST_DB_PATH=/app/logboost_admin.db

# ============================================================
# LOGGING
# ============================================================

# Gunicorn log level (debug, info, warning, error, critical)
# Controls both access log and error log verbosity
# Default: info
LOGBOOST_LOG_LEVEL=info
